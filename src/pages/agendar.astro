---
import Layout from '../layouts/Layout.astro';
const calendarUrl = 'https://calendar.app.google/C2T6QcFanfcL2QJG7';
---

<Layout title="Agendando consulta" noindex={true}>
  <div class="redirect-page">
    <div class="redirect-card">
      <div class="redirect-spinner"></div>
      <p class="redirect-label">Un momento</p>
      <h1 class="redirect-heading">Preparando tu consulta</h1>
      <p class="redirect-sub">
        Te estamos redirigiendo al calendario de reservas.<br />
        Si no eres redirigido automáticamente,
        <a class="redirect-link" href={calendarUrl} target="_blank" rel="noopener noreferrer">
          haz clic aquí.
        </a>
      </p>
    </div>
  </div>
</Layout>

<script>
  // Redirect after 1.5s — gives GA time to register the pageview
  setTimeout(() => {
    window.location.href = 'https://calendar.app.google/C2T6QcFanfcL2QJG7';
  }, 1500);
</script>

<style>
  .redirect-page {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    background: var(--bg);
  }

  .redirect-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 440px;
    width: 100%;
    padding: 56px 40px;
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 24px;
  }

  .redirect-spinner {
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--border);
    border-top-color: var(--text);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 32px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .redirect-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text3);
    margin-bottom: 12px;
  }

  .redirect-heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 16px;
  }

  .redirect-sub {
    font-size: 14px;
    font-weight: 300;
    color: var(--text2);
    line-height: 1.7;
  }

  .redirect-link {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
