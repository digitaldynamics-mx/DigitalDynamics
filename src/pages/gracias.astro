---
import Layout from '../layouts/Layout.astro';
---

<Layout title="¡Consulta agendada! — Digital Dynamics">
  <div class="confirm-page">
    <div class="confirm-card">
      <div class="confirm-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <p class="confirm-label">Consulta agendada</p>
      <h1 class="confirm-heading">¡Nos vemos pronto!</h1>
      <p class="confirm-sub">
        Recibiste un correo de confirmación con los detalles de tu cita.<br />
        Estamos listos para escucharte y ayudarte a transformar tu negocio.
      </p>
      <a class="confirm-btn" href="/">Volver al inicio</a>
    </div>
  </div>
</Layout>

<style>
  .confirm-page {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    background: var(--bg);
  }

  .confirm-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 480px;
    width: 100%;
    padding: 56px 40px;
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: 24px;
  }

  .confirm-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(48, 209, 88, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
  }

  .confirm-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text3);
    margin-bottom: 12px;
  }

  .confirm-heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(32px, 6vw, 52px);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 20px;
  }

  .confirm-sub {
    font-size: 15px;
    font-weight: 300;
    color: var(--text2);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .confirm-btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--bg);
    background: var(--text);
    border-radius: 100px;
    padding: 12px 32px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
  }

  .confirm-btn:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }
</style>
