---
const steps = [
  {
    number: '01',
    title: 'Diagnóstico gratuito',
    description:
      'Nos reunimos contigo para entender cómo opera tu negocio hoy: qué procesos son manuales, dónde se pierde tiempo y qué oportunidades de mejora existen. Sin tecnicismos, sin compromiso.',
  },
  {
    number: '02',
    title: 'Propuesta a medida',
    description:
      'Diseñamos una solución específica para tu caso. Te explicamos qué vamos a construir, por qué, cuánto tiempo toma y cuánto cuesta — todo en lenguaje claro.',
  },
  {
    number: '03',
    title: 'Desarrollo iterativo',
    description:
      'Construimos en ciclos cortos. Cada semana tienes visibilidad de lo que se avanzó. Puedes dar retroalimentación en tiempo real; nada se entrega como sorpresa al final.',
  },
  {
    number: '04',
    title: 'Entrega y acompañamiento',
    description:
      'Lanzamos juntos. Te capacitamos, resolvemos dudas y seguimos disponibles después del go-live. La relación no termina con la entrega.',
  },
];
---

<section class="section wp-section" id="proceso">
  <p class="section-label reveal">Cómo trabajamos</p>
  <h2 class="section-title reveal" style="transition-delay:0.08s">
    De la idea a la solución, <em>sin sorpresas.</em>
  </h2>

  <!-- Carousel -->
  <div class="wp-carousel reveal" style="transition-delay:0.16s">
    <div class="wp-viewport" id="wpViewport">
      <div class="wp-track" id="wpTrack">
        {steps.map((step, i) => (
          <div class="wp-slide">
            <span class="wp-counter">0{i + 1} / 0{steps.length}</span>
            <span class="wp-num">{step.number}</span>
            <h3 class="wp-title">{step.title}</h3>
            <p class="wp-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="wp-controls">
      <button class="wp-btn" id="wpPrev" aria-label="Anterior" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
      <div class="wp-dots" id="wpDots"></div>
      <button class="wp-btn" id="wpNext" aria-label="Siguiente">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>

</section>

<style>
  .wp-section { padding-bottom: 80px; }

  /* ── Carousel ── */
  .wp-carousel { margin-top: 64px; }

  .wp-viewport {
    overflow: hidden;
    border: 0.5px solid var(--border);
    border-radius: 20px;
  }

  .wp-track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .wp-slide {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 72px 80px;
    background: var(--bg);
    position: relative;
    transition: background 0.25s;
  }
  .wp-slide:hover { background: var(--bg2); }

  .wp-counter {
    position: absolute;
    top: 28px;
    right: 32px;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text3);
  }

  .wp-num {
    font-family: 'Syne', sans-serif;
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text3);
    line-height: 1;
    margin-bottom: 24px;
    transition: color 0.3s ease;
  }
  .wp-slide:hover .wp-num { color: var(--text); }

  .wp-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .wp-desc {
    font-size: 15px;
    font-weight: 300;
    color: var(--text2);
    line-height: 1.75;
    max-width: 520px;
  }

  /* ── Controls ── */
  .wp-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 32px;
  }

  .wp-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg2);
    border: 0.5px solid var(--border);
    color: var(--text2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, opacity 0.2s;
  }
  .wp-btn:hover:not(:disabled) { background: var(--bg3); color: var(--text); }
  .wp-btn:disabled { opacity: 0.25; cursor: default; }

  .wp-dots { display: flex; align-items: center; gap: 8px; }

  :global(.wp-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bg3);
    border: 0.5px solid var(--text3);
    padding: 0;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s, border-color 0.25s;
  }
  :global(.wp-dot.active) {
    background: var(--text);
    border-color: var(--text);
    transform: scale(1.4);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .wp-slide { padding: 52px 32px 48px; }
    .wp-counter { top: 20px; right: 20px; }
  }

  @media (max-width: 480px) {
    .wp-slide { padding: 48px 24px 44px; }
    .wp-viewport { border-radius: 16px; }
  }
</style>

<script>
  const viewport = document.getElementById('wpViewport')!;
  const track    = document.getElementById('wpTrack')!;
  const prevBtn  = document.getElementById('wpPrev') as HTMLButtonElement;
  const nextBtn  = document.getElementById('wpNext') as HTMLButtonElement;
  const dotsEl   = document.getElementById('wpDots')!;
  const TOTAL    = 4;
  let current    = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  function slide(idx: number, instant = false) {
    current = Math.max(0, Math.min(idx, TOTAL - 1));
    if (instant) track.style.transition = 'none';
    track.style.transform = `translateX(${-current * viewport.clientWidth}px)`;
    if (instant) requestAnimationFrame(() => { track.style.transition = ''; });
    dotsEl.querySelectorAll('.wp-dot').forEach((d, i) =>
      d.classList.toggle('active', i === current)
    );
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === TOTAL - 1;
  }

  function buildDots() {
    dotsEl.innerHTML = '';
    for (let i = 0; i < TOTAL; i++) {
      const btn = document.createElement('button');
      btn.className = 'wp-dot' + (i === current ? ' active' : '');
      btn.setAttribute('aria-label', `Paso ${i + 1}`);
      btn.addEventListener('click', () => { slide(i); resetAuto(); });
      dotsEl.appendChild(btn);
    }
  }

  function startAuto() {
    autoTimer = setInterval(() => {
      slide(current >= TOTAL - 1 ? 0 : current + 1);
    }, 4500);
  }

  function resetAuto() { clearInterval(autoTimer); startAuto(); }

  buildDots();
  slide(0, true);
  startAuto();

  prevBtn.addEventListener('click', () => { slide(current - 1); resetAuto(); });
  nextBtn.addEventListener('click', () => { slide(current + 1); resetAuto(); });

  viewport.addEventListener('mouseenter', () => clearInterval(autoTimer));
  viewport.addEventListener('mouseleave', startAuto);

  window.addEventListener('resize', () => { slide(current, true); });

  let touchStartX = 0;
  viewport.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  viewport.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) { slide(dx < 0 ? current + 1 : current - 1); resetAuto(); }
  }, { passive: true });
</script>
