---
const services = [
  {
    icon: '⚙️',
    title: 'Automatización',
    description:
      'Eliminamos el trabajo repetitivo. Tus procesos, corriendo solos mientras tú te enfocas en lo que importa.',
  },
  {
    icon: '📱',
    title: 'Apps web y móvil',
    description:
      'Interfaces que tus equipos y clientes quieren usar. Diseñadas para la operación real, no para demos.',
  },
  {
    icon: '🔗',
    title: 'Integraciones',
    description:
      'Conectamos tus herramientas para que la información fluya sola. Adiós al copiar y pegar entre sistemas.',
  },
  {
    icon: '🧭',
    title: 'Consultoría tech',
    description:
      'Te ayudamos a tomar decisiones tecnológicas con claridad, sin que tengas que entender de código.',
  },
  {
    icon: '🏗️',
    title: 'Desarrollo a medida',
    description:
      'Software hecho exactamente para cómo funciona tu empresa. Sin plantillas, sin compromisos.',
  },
  {
    icon: '🔄',
    title: 'Transformación digital',
    description:
      'Acompañamiento completo para empresas listas para dejar atrás el Excel y los procesos manuales.',
  },
];
---

<section class="section" id="servicios">
  <p class="section-label reveal">Lo que hacemos</p>
  <h2 class="section-title reveal" style="transition-delay:0.08s">
    Soluciones que <em>realmente</em> mueven tu negocio
  </h2>

  <div class="svc-carousel reveal" style="transition-delay:0.16s">
    <div class="svc-viewport" id="svcViewport">
      <div class="svc-track" id="svcTrack">
        {services.map((service, i) => (
          <div class="service-card svc-slide">
            <span class="svc-counter">0{i + 1} / 0{services.length}</span>
            <div class="service-icon svc-icon-lg">{service.icon}</div>
            <h3 class="svc-title">{service.title}</h3>
            <p class="svc-desc">{service.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="svc-controls">
      <button class="svc-btn" id="svcPrev" aria-label="Anterior" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
      <div class="svc-dots" id="svcDots"></div>
      <button class="svc-btn" id="svcNext" aria-label="Siguiente">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .svc-carousel { margin-top: 64px; }

  .svc-viewport {
    overflow: hidden;
    border: 0.5px solid var(--border);
    border-radius: 20px;
  }

  .svc-track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* ── full-width slide card ── */
  .svc-slide {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 72px 80px;
    position: relative;
  }

  .svc-counter {
    position: absolute;
    top: 28px;
    right: 32px;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text3);
  }

  .svc-icon-lg {
    width: 64px !important;
    height: 64px !important;
    font-size: 28px !important;
    border-radius: 18px !important;
    margin-bottom: 28px !important;
  }

  .svc-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(22px, 3.5vw, 32px) !important;
    font-weight: 700 !important;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 16px !important;
  }

  .svc-desc {
    font-size: 16px !important;
    font-weight: 300 !important;
    color: var(--text2) !important;
    line-height: 1.7 !important;
    max-width: 480px;
  }

  /* ── controls ── */
  .svc-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 32px;
  }

  .svc-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg2);
    border: 0.5px solid var(--border);
    color: var(--text2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, opacity 0.2s;
  }
  .svc-btn:hover:not(:disabled) {
    background: var(--bg3);
    color: var(--text);
  }
  .svc-btn:disabled { opacity: 0.25; cursor: default; }

  .svc-dots { display: flex; align-items: center; gap: 8px; }

  :global(.svc-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bg3);
    border: 0.5px solid var(--text3);
    padding: 0;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s, border-color 0.25s;
  }
  :global(.svc-dot.active) {
    background: var(--text);
    border-color: var(--text);
    transform: scale(1.4);
  }

  @media (max-width: 768px) {
    .svc-slide { padding: 52px 32px 48px; }
    .svc-counter { top: 20px; right: 20px; }
    .svc-desc { font-size: 15px !important; }
  }

  @media (max-width: 480px) {
    .svc-slide { padding: 48px 24px 44px; }
    .svc-viewport { border-radius: 16px; }
  }
</style>

<script>
  const viewport = document.getElementById('svcViewport')!;
  const track    = document.getElementById('svcTrack')!;
  const prevBtn  = document.getElementById('svcPrev') as HTMLButtonElement;
  const nextBtn  = document.getElementById('svcNext') as HTMLButtonElement;
  const dotsEl   = document.getElementById('svcDots')!;
  const TOTAL    = 6;
  let current    = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  function slide(idx: number, instant = false) {
    current = Math.max(0, Math.min(idx, TOTAL - 1));
    if (instant) track.style.transition = 'none';
    track.style.transform = `translateX(${-current * viewport.clientWidth}px)`;
    if (instant) requestAnimationFrame(() => { track.style.transition = ''; });
    dotsEl.querySelectorAll('.svc-dot').forEach((d, i) =>
      d.classList.toggle('active', i === current)
    );
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === TOTAL - 1;
  }

  function buildDots() {
    dotsEl.innerHTML = '';
    for (let i = 0; i < TOTAL; i++) {
      const btn = document.createElement('button');
      btn.className = 'svc-dot' + (i === current ? ' active' : '');
      btn.setAttribute('aria-label', `Slide ${i + 1}`);
      btn.addEventListener('click', () => { slide(i); resetAuto(); });
      dotsEl.appendChild(btn);
    }
  }

  function startAuto() {
    autoTimer = setInterval(() => {
      slide(current >= TOTAL - 1 ? 0 : current + 1);
    }, 4000);
  }

  function resetAuto() { clearInterval(autoTimer); startAuto(); }

  buildDots();
  slide(0, true);
  startAuto();

  prevBtn.addEventListener('click', () => { slide(current - 1); resetAuto(); });
  nextBtn.addEventListener('click', () => { slide(current + 1); resetAuto(); });

  viewport.addEventListener('mouseenter', () => clearInterval(autoTimer));
  viewport.addEventListener('mouseleave', startAuto);

  window.addEventListener('resize', () => { slide(current, true); });

  let touchStartX = 0;
  viewport.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  viewport.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) { slide(dx < 0 ? current + 1 : current - 1); resetAuto(); }
  }, { passive: true });

  track.querySelectorAll<HTMLElement>('.service-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const rotY = ((e.clientX - rect.left - rect.width  / 2) / (rect.width  / 2)) * 6;
      const rotX = -((e.clientY - rect.top  - rect.height / 2) / (rect.height / 2)) * 4;
      card.style.transform = `perspective(800px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateZ(4px)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(0)';
    });
  });
</script>
